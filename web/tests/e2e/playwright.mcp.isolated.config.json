{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false
    },
    "contextOptions": {
      "baseURL": "http://127.0.0.1:5173",
      "storageState": "./tests/e2e/.auth/user.json",
      "viewport": {
        "width": 1440,
        "height": 900
      },
      "locale": "zh-CN"
    }
  },
  "capabilities": [
    "core",
    "vision",
    "devtools"
  ],
  "outputDir": "./tests/e2e/.mcp-output/isolated",
  "saveSession": true,
  "testIdAttribute": "data-testid",
  "console": {
    "level": "info"
  },
  "timeouts": {
    "action": 5000,
    "navigation": 60000,
    "expect": 5000
  },
  "network": {
    "allowedOrigins": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
