# Frontend environment example.
# Copy to web/.env.development.local for local overrides.

# Leave empty to use same-origin / Vite proxy defaults.
VITE_API_BASE_URL=
VITE_WS_URL=

VITE_APP_TITLE=kageos
VITE_APP_ENV=development
# Optional installed-app label. Dev defaults to "kageos Local"; production defaults to "kageos".
VITE_PWA_APP_NAME=

# In-app help links always open the public docs at https://kageos.ai.
