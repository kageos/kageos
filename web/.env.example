# Frontend environment example.
# Copy to web/.env.development.local for local overrides.

# Leave empty to use same-origin / Vite proxy defaults.
VITE_API_BASE_URL=
VITE_WS_URL=

VITE_APP_TITLE=Kageos
VITE_APP_ENV=development

# Public website root used by in-app help links. For local website preview:
# VITE_KAGEOS_DOCS_BASE_URL=http://127.0.0.1:4322
VITE_KAGEOS_DOCS_BASE_URL=https://kageos.com
