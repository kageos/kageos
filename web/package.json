{
  "name": "kageos-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "run-s check:architecture && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:login": "E2E_SKIP_AUTH_SETUP=1 playwright test tests/e2e/login-page.spec.ts --project chromium-public",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project chromium",
    "test:e2e:workspace-nav": "playwright test tests/e2e/workspace-navigation.spec.ts --project chromium",
    "test:e2e:service-tree": "playwright test tests/e2e/service-tree-actions.spec.ts --project chromium",
    "test:e2e:workstation": "playwright test tests/e2e/workstation-open.spec.ts --project chromium",
    "test:e2e:workstation-compose": "playwright test tests/e2e/workstation-composer.spec.ts --project chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "audit:i18n": "node scripts/audit-i18n-hardcoded.mjs",
    "audit:i18n:strict": "node scripts/audit-i18n-hardcoded.mjs --fail-on-findings",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "playwright:install": "playwright install chromium",
    "playwright:mcp": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.persistent.config.json",
    "playwright:mcp:isolated": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.isolated.config.json",
    "playwright:mcp:http": "npx -y @playwright/mcp@latest --config ./tests/e2e/playwright.mcp.persistent.config.json --port 8931"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/loader": "^1.6.1",
    "@tiptap/extension-code": "^3.11.0",
    "@tiptap/extension-code-block": "^3.11.0",
    "@tiptap/extension-color": "^3.11.0",
    "@tiptap/extension-dropcursor": "^3.11.0",
    "@tiptap/extension-focus": "^3.11.0",
    "@tiptap/extension-gapcursor": "^3.11.0",
    "@tiptap/extension-highlight": "^3.11.0",
    "@tiptap/extension-history": "^3.11.0",
    "@tiptap/extension-image": "^3.11.0",
    "@tiptap/extension-link": "^3.11.0",
    "@tiptap/extension-placeholder": "^3.11.0",
    "@tiptap/extension-table": "^3.11.0",
    "@tiptap/extension-table-cell": "^3.11.0",
    "@tiptap/extension-table-header": "^3.11.0",
    "@tiptap/extension-table-row": "^3.11.0",
    "@tiptap/extension-task-item": "^3.11.0",
    "@tiptap/extension-task-list": "^3.11.0",
    "@tiptap/extension-text-align": "^3.11.0",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/extension-underline": "^3.11.0",
    "@tiptap/markdown": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@tiptap/vue-3": "^3.11.0",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.18",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.5",
    "js-sha256": "^0.10.1",
    "jszip": "^3.10.1",
    "marked": "^17.0.1",
    "monaco-editor": "^0.53.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "pinyin-pro": "^3.28.1",
    "prosemirror-transform": "^1.10.5",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.2",
    "vditor": "^3.11.2",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.11",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "exceljs": "^4.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.93.3",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    },
    "linkify-it": "5.0.2",
    "postcss": "8.5.23"
  }
}
