# Docker 构建排除文件
# 减少构建上下文大小，加速构建

# Git
.git
.gitignore

# IDE
.cursor
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node modules（前端 Dockerfile 内部安装）
web/node_modules
enterprise_impl/hub/frontend/node_modules
node_modules

# Go 构建缓存
vendor

# 日志和运行时数据
logs/
*.log
data/
*.db

# 文档和笔记
note/
blueprint/
test/
*.plan.md

# 本地配置（使用 docker/configs 覆盖）
