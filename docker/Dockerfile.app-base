# ai-agent-os 用户应用基础镜像
# 包含 Python3、FFmpeg、LibreOffice、Pandoc、GraphicsMagick、Tesseract、中文字体等
# 构建: docker build -t ai-agent-os:latest -f docker/Dockerfile.app-base .

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8

# 基础工具 + 语言环境
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini ca-certificates curl wget locales tzdata \
    && sed -i 's/# zh_CN.UTF-8/zh_CN.UTF-8/' /etc/locale.gen \
    && locale-gen zh_CN.UTF-8 \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# Python3 + pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# 预装常用 Python 包
RUN pip3 install --no-cache-dir --break-system-packages \
    pandas numpy matplotlib jieba openpyxl xlsxwriter Pillow requests

# 记录已安装的 Python 包（供 SDK 快速检查）
RUN pip3 list --format=columns --disable-pip-version-check 2>/dev/null \
    | tail -n +3 | awk '{print tolower($1)}' | tr '\n' ',' \
    > /etc/python-installed-packages.txt \
    && echo '#!/bin/sh' > /etc/profile.d/python-packages.sh \
    && echo "export PYTHON_INSTALLED_PACKAGES=\"$(cat /etc/python-installed-packages.txt)\"" \
    >> /etc/profile.d/python-packages.sh \
    && chmod +x /etc/profile.d/python-packages.sh

# 多媒体处理工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ghostscript \
    poppler-utils \
    graphicsmagick \
    graphviz \
    lua5.4 \
    && ln -sf /usr/bin/lua5.4 /usr/bin/lua \
    && rm -rf /var/lib/apt/lists/*

# OCR (Tesseract + 中文模型)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
    && rm -rf /var/lib/apt/lists/*

# 文档转换工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-common \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

# CJK 中文字体 (Noto Sans/Serif CJK)
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk fonts-noto-cjk-extra \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# matplotlib 中文字体配置
RUN python3 -c "\
import matplotlib; \
import os; \
mpl_dir = matplotlib.get_configdir(); \
os.makedirs(mpl_dir, exist_ok=True); \
with open(os.path.join(mpl_dir, 'matplotlibrc'), 'w') as f: \
    f.write('font.sans-serif: Noto Sans CJK SC, DejaVu Sans\n'); \
    f.write('axes.unicode_minus: False\n'); \
" && python3 -c "import matplotlib.font_manager; matplotlib.font_manager._load_fontmanager(try_read_cache=False)"

# 创建应用目录
RUN mkdir -p /app/workplace/bin/releases /app/workplace/metadata /app/workplace/data /app/workplace/logs /app/workplace/conf

# 复制启动脚本
COPY scripts/start.sh /start.sh
RUN chmod +x /start.sh

WORKDIR /app

ENTRYPOINT ["tini", "--"]
CMD ["/start.sh"]
