# Go 后端统一 Dockerfile
# 构建核心服务（7个服务统一启动）+ Hub 服务
# 构建: docker build -t ai-agent-os-backend:latest -f docker/Dockerfile.backend .

# ========== Stage 1: 编译 ==========
FROM golang:1.24-bookworm AS builder

WORKDIR /src

# 安装编译依赖（podman bindings 的间接依赖可能需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev libgpgme-dev libdevmapper-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 先复制 go.mod/go.sum 利用 Docker 缓存
COPY go.mod go.sum ./

# 下载主模块依赖（此层会被缓存，除非 go.mod 变化）
# Hub 模块的依赖大部分与主模块重叠，会在 build 时自动解析
RUN go mod download

# 复制全部源码
COPY . .

# 编译核心服务（统一入口）
RUN CGO_ENABLED=1 GOOS=linux go build \
    -tags "exclude_graphdriver_btrfs" \
    -ldflags="-s -w" \
    -o /out/core-server \
    ./core/cmd/main/main.go

# 编译 Hub 服务
RUN cd enterprise_impl/hub/backend && \
    CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/hub-server \
    ./cmd/app/main.go

# ========== Stage 2: 运行 ==========
FROM debian:bookworm-slim

ENV TZ=Asia/Shanghai
ENV LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata libgpgme11 libdevmapper1.02.1 git \
    podman buildah fuse-overlayfs slirp4netns crun \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# Podman 配置：容器使用 host 网络（共享 backend 容器网络栈）
RUN mkdir -p /etc/containers && \
    printf '[containers]\nnetns = "host"\n' > /etc/containers/containers.conf && \
    printf '[storage]\ndriver = "overlay"\n' > /etc/containers/storage.conf && \
    printf 'unqualified-search-registries = ["docker.io"]\n' > /etc/containers/registries.conf && \
    mkdir -p /var/lib/containers/storage /run/podman

# app-runtime 需要 Go 编译器来编译用户应用（go build）
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV GOCACHE="/tmp/go-cache"

WORKDIR /app

# 复制编译产物
COPY --from=builder /out/core-server /app/core-server
COPY --from=builder /out/hub-server /app/hub-server

# 用户应用编译需要完整的 Go 模块环境：
# - 用户应用在 namespace/ 下，属于主模块（共用根 go.mod）
# - go build/mod tidy 需要能找到所有被引用的包
# 从 builder 复制 Go 源码（排除前端、构建产物等非 Go 文件）
COPY --from=builder /src/go.mod /src/go.sum /app/
COPY --from=builder /src/sdk/ /app/sdk/
COPY --from=builder /src/pkg/ /app/pkg/
COPY --from=builder /src/dto/ /app/dto/
COPY --from=builder /src/core/ /app/core/
COPY --from=builder /src/enterprise_impl/hub/backend/ /app/enterprise_impl/hub/backend/
# 复制 Go 模块缓存（避免首次编译用户应用时重新下载）
COPY --from=builder /go/pkg/mod /go/pkg/mod

# 复制配置文件（运行时可通过 volume 覆盖）
COPY configs/ /app/configs/
COPY enterprise_impl/hub/backend/config/ /app/hub-config/

# Hub Server 从 ../../config/hub.yaml (相对 cwd) 加载配置
# 二进制在 /app 运行 → ../../config/hub.yaml → /config/hub.yaml
RUN mkdir -p /config && ln -sf /app/hub-config/hub.yaml /config/hub.yaml

# 复制用户应用基础镜像构建文件（Podman 首次启动时构建）
COPY docker/Dockerfile.app-base /app/app-base/Dockerfile
COPY scripts/start.sh /app/app-base/scripts/start.sh

# 复制启动脚本
COPY docker/entrypoint-backend.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 创建运行时目录
RUN mkdir -p /app/namespace /app/data /app/logs /app/license

EXPOSE 9090 9091 9092 9093 9094 9095 9096 9097

ENTRYPOINT ["/app/entrypoint.sh"]
