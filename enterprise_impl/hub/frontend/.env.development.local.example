# Hub 前端开发 - 连线上时复制为 .env.development.local 后修改
# cp .env.development.local.example .env.development.local

# ========== 连线上后端 ==========
# Hub API 代理目标（线上 Hub 入口，不要末尾斜杠）
# VITE_PROXY_TARGET=http://125.122.96.207:8998

# 主站 API（/hr 等走主站，线上主站入口）
# VITE_OS_PROXY_TARGET=http://125.122.96.207:8999

# 跳转主站登录等（可选，默认用下面地址）
# VITE_OS_LOGIN_URL=http://125.122.96.207:8999/login
# VITE_OS_FRONTEND_URL=http://125.122.96.207:8999
# VITE_OS_BASE_URL=http://125.122.96.207:8999

# ========== 本地后端 ==========
# 不创建本文件或留空上述变量，则代理到 localhost:9090 和 localhost:5173（主站 dev）
