# 由 entrypoint envsubst 生成；变量：CANONICAL_HOST、CANONICAL_SERVER_NAME、CANONICAL_SCHEME、HTTP_PORT、HTTPS_PORT、TLS_CERT_FILE、TLS_KEY_FILE
# main 容器使用 host 网络，Nginx 同时监听 HTTP_PORT / HTTPS_PORT 对外服务

server {
    listen ${HTTP_PORT};
    server_name www.${CANONICAL_SERVER_NAME};
    return 301 ${CANONICAL_SCHEME}://${CANONICAL_HOST}$request_uri;
}

server {
    listen ${HTTPS_PORT} ssl http2;
    server_name www.${CANONICAL_SERVER_NAME};
    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    return 301 ${CANONICAL_SCHEME}://${CANONICAL_HOST}$request_uri;
}

server {
    listen ${HTTP_PORT} default_server;
    server_name ${CANONICAL_SERVER_NAME} _;
    include /etc/nginx/snippets/kageos-common.conf;
}

server {
    listen ${HTTPS_PORT} ssl http2 default_server;
    server_name ${CANONICAL_SERVER_NAME} _;

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    include /etc/nginx/snippets/kageos-common.conf;
}
