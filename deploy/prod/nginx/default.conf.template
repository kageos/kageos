# 由 entrypoint envsubst 生成；变量：CANONICAL_HOST、CANONICAL_SERVER_NAME、CANONICAL_SCHEME、HTTP_PORT
# main 容器使用 host 网络，Nginx 直接监听 HTTP_PORT 端口对外服务

server {
    listen ${HTTP_PORT};
    server_name www.${CANONICAL_SERVER_NAME};
    return 301 ${CANONICAL_SCHEME}://${CANONICAL_HOST}$request_uri;
}

server {
    listen ${HTTP_PORT} default_server;
    server_name ${CANONICAL_SERVER_NAME} _;
    include /etc/nginx/snippets/kageos-common.conf;
}
