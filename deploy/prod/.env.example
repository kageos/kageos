# 客户部署环境（复制为 .env 后填写；勿提交含真实密钥的 .env）
# 推荐流程：
#   1. bash build.sh init
#   2. 修改 CANONICAL_BASE_URL / STORAGE_ROOT / HTTPS
#   3. bash build.sh doctor
#   4. bash build.sh up

# 主站公网地址；如果开启 HTTPS，请改成 https://
CANONICAL_BASE_URL="http://example.com"
STORAGE_ROOT="/data/ai-agent-os"

# MySQL root 密码
MYSQL_ROOT_PASSWORD=""

# 中间件镜像 tag；建议正式环境固定版本，不要长期停留在 latest
MYSQL_IMAGE="mysql:8.0"
NATS_IMAGE="nats:2.10-alpine"
MINIO_IMAGE="minio/minio:latest"

# 至少 32 个字符，建议: openssl rand -hex 32
JWT_SECRET=""

# 必须正好 32 个字符，建议: openssl rand -hex 16
CONTROL_ENC_KEY=""

# MinIO 管理员账号
MINIO_ROOT_USER=""

# MinIO 管理员密码
MINIO_ROOT_PASSWORD=""

BACKUP_BASIC_AUTH_USERNAME="admin"

# 至少 16 个字符，建议: openssl rand -hex 24
BACKUP_BASIC_AUTH_PASSWORD=""

SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="AI Agent OS"

# HTTPS 可选开启：默认仍是 HTTP
# 0=仅 HTTP，1=启用 HTTPS
ENABLE_HTTPS="0"
# 仅在 ENABLE_HTTPS=1 时生效；1=80 强制跳转到 443
HTTPS_REDIRECT="0"
# 证书宿主机目录，会挂载到容器内 /app/tls
TLS_CERTS_HOST_DIR="./certs"
TLS_CERT_FILE="/app/tls/fullchain.pem"
TLS_KEY_FILE="/app/tls/privkey.pem"

# main 服务镜像标签；默认给本地 build 流程使用，也可改成远程已发布 tag 后配合 build.sh up-image / update-image
MAIN_IMAGE="agentos-main:latest"
# 用户应用运行时基础镜像标签；如需改名，优先只改这一处
APP_BASE_IMAGE="agentos-app-runtime-base:latest"

# 生产固定目录（必填），build.sh 会自动创建以下目录：
# ${STORAGE_ROOT}/mysql
# ${STORAGE_ROOT}/minio
# ${STORAGE_ROOT}/podman_storage
# ${STORAGE_ROOT}/logs
# ${STORAGE_ROOT}/namespace
# ${STORAGE_ROOT}/data
