# 客户部署环境（复制为 .env 后填写；勿提交含真实密钥的 .env）
# 一键部署：bash build.sh

CANONICAL_BASE_URL="http://example.com"  # 开启 HTTPS 后改成 https://
STORAGE_ROOT="/data/ai-agent-os"

MYSQL_ROOT_PASSWORD=""
JWT_SECRET=""                     # 至少 32 个字符，建议: openssl rand -hex 32
CONTROL_ENC_KEY=""               # 必须正好 32 个字符，建议: openssl rand -hex 16
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
BACKUP_BASIC_AUTH_USERNAME="admin"
BACKUP_BASIC_AUTH_PASSWORD=""    # 至少 16 个字符，建议: openssl rand -hex 24

SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_FROM_NAME="AI Agent OS"

# HTTPS 可选开启：默认仍是 HTTP
ENABLE_HTTPS="0"                # 0=仅 HTTP，1=启用 HTTPS
HTTPS_REDIRECT="0"              # 仅在 ENABLE_HTTPS=1 时生效；1=80 强制跳转到 443
TLS_CERTS_HOST_DIR="./certs"    # 证书宿主机目录，会挂载到容器内 /app/tls
TLS_CERT_FILE="/app/tls/fullchain.pem"
TLS_KEY_FILE="/app/tls/privkey.pem"

# main 服务本地构建产物的镜像标签
MAIN_IMAGE="ai-agent-os-main:latest"

# 生产固定目录（必填），build.sh 会自动创建以下目录：
# ${STORAGE_ROOT}/mysql
# ${STORAGE_ROOT}/minio
# ${STORAGE_ROOT}/podman_storage
# ${STORAGE_ROOT}/logs
# ${STORAGE_ROOT}/namespace
# ${STORAGE_ROOT}/data
