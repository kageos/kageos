# 客户部署环境（复制为 .env 后填写；勿提交含真实密钥的 .env）
# 推荐流程：
#   1. bash build.sh init     # 或 bash build.sh init --image
#   2. 填写 CANONICAL_BASE_URL；按需调整 TLS_MODE
#   3. bash build.sh up
#   4. 如需显式预检，再执行 bash build.sh doctor

# 主站公网地址（必填）；如果 TLS_MODE=external / https / redirect，通常这里也应写 https://
CANONICAL_BASE_URL=""

# MySQL root 密码
MYSQL_ROOT_PASSWORD=""

# 至少 32 个字符，建议: openssl rand -hex 32
JWT_SECRET=""

# 必须正好 32 个字符，建议: openssl rand -hex 16
CONTROL_ENC_KEY=""

# MinIO 管理员密码
MINIO_ROOT_PASSWORD=""

# 至少 16 个字符，建议: openssl rand -hex 24
BACKUP_BASIC_AUTH_PASSWORD=""

# 传输模式：
# http=容器仅 HTTP
# https=容器同时提供 HTTP + HTTPS
# redirect=容器提供 HTTPS，且 80 强制跳转 443
# external=容器仅 HTTP，由外部 LB / CDN / 网关终止 TLS
TLS_MODE="http"
# 证书宿主机目录，会挂载到容器内 /app/tls
TLS_CERTS_HOST_DIR="./certs"
TLS_CERT_FILE="/app/tls/fullchain.pem"
TLS_KEY_FILE="/app/tls/privkey.pem"

# 如需启用邮件验证码，再按需增加：
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
#
# 如需覆盖默认 SMTP 主机 / 端口 / 发件名，再按需增加：
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="587"
# SMTP_FROM_NAME="AI Agent OS"
#
# 如需覆盖默认镜像，再按需增加：
# MYSQL_IMAGE="mysql:8.0"
# NATS_IMAGE="nats:2.10-alpine"
# MINIO_IMAGE="minio/minio:latest"
# MAIN_IMAGE="agentos-main:latest"
# APP_BASE_IMAGE="agentos-app-runtime-base:latest"

# 生产固定目录固定为 /data/ai-agent-os，build.sh 会自动创建以下目录：
# /data/ai-agent-os/mysql
# /data/ai-agent-os/minio
# /data/ai-agent-os/podman_storage
# /data/ai-agent-os/logs
# /data/ai-agent-os/namespace
# /data/ai-agent-os/data
