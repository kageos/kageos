# 客户主站 Compose：复制为 .env 后逐项填写（无默认值，部署前请执行 ./check-env.sh）
#   cp .env.example .env && vim .env && chmod +x check-env.sh && ./check-env.sh

# 主站公网地址（唯一真值，须含协议，如 https://example.com）
CANONICAL_BASE_URL=

# MySQL root（与 config 模板占位符一致）
MYSQL_ROOT_PASSWORD=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# 应用密钥（JWT 建议足够长随机串；CONTROL_ENC_KEY 须与许可证/控制面约定一致）
JWT_SECRET=
CONTROL_ENC_KEY=

# 发信密码；不用 SMTP 时留空即可（允许空）
SMTP_PASSWORD=

# 宿主机映射到 main 容器 8080 的端口
HTTP_PUBLISH_PORT=

# 构建产出的主镜像名（与 compose build 的 tag 一致即可）
MAIN_IMAGE=
