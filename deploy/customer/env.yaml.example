# 客户部署环境（单一真值：canonical_base_url = geeleo.com）
# 用法：cp env.yaml.example env.yaml 后编辑，再执行 ./render-env.sh 生成 .env 供 docker compose 使用

site:
  canonical_base_url: "https://geeleo.com"
  # 边缘 Nginx 内置于 main 容器；HTTP 对外端口由 compose 的 HTTP_PUBLISH_PORT 映射

secrets:
  mysql_root_password: "changeme-strong"
  jwt_secret: "change-me-jwt-secret-min-32-characters-long!!"
  control_encryption_key: "ai-agent-os-license-key-32bytes!"
  minio_root_user: "minioadmin"
  minio_root_password: "minioadmin123-change-me"
  smtp_password: ""

ports:
  http_publish: 80

image:
  main: "ai-agent-os-main:latest"
