# 必填：复制为 env.yaml 后按本结构手写填写（勿提交 env.yaml 到 Git）
# 生成 Compose 环境：./render-env.sh   （会写出 .env，用户无需编辑 .env）

site:
  canonical_base_url: "https://example.com"

secrets:
  mysql_root_password: ""
  jwt_secret: ""
  control_encryption_key: ""
  minio_root_user: ""
  minio_root_password: ""
  smtp_password: ""

image:
  main: "ai-agent-os-main:latest"
