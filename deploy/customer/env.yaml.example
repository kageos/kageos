# 必填：复制为 env.yaml 后按本结构手写填写（勿提交 env.yaml 到 Git）
# 一键部署：bash build.sh（自动解析 env.yaml → .env + compose up）

site:
  canonical_base_url: "https://example.com"

secrets:
  mysql_root_password: ""
  jwt_secret: ""
  control_encryption_key: ""
  minio_root_user: ""
  minio_root_password: ""
  smtp_password: ""

image:
  main: "ai-agent-os-main:latest"
