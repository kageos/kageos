  ],
  "acceptance_cases": [
    {
      "name": "查看工单列表",
      "action": "进入工单列表页面，使用状态和优先级筛选。",
      "expected": "列表按条件刷新，并保留分页能力。"
    },
    {
      "name": "新增工单",
      "action": "点击新增，填写必填字段后提交。",
      "expected": "工单创建成功，提单部门和创建用户由后端补齐。"
    },
    {
      "name": "更新工单状态",
      "action": "编辑工单，将状态改为已关闭。",
      "expected": "状态更新成功，处理耗时按创建时间自动计算。"
    },
    {
      "name": "删除工单",
      "action": "勾选工单后点击删除。",
      "expected": "选中工单被软删除，列表刷新。"
    }
  ],
  "confirmation": {
    "question": "请确认是否按以上 PRD 创建目录和生成代码：\n- 是否创建新目录：是\n- 目录名称：工单管理\n- 目录 code：ticket_management\n- 将创建/修改的功能：ticket_list.table\n\n确认后我再进入开发阶段，按 PRD 直接创建目录、写 Go 文件并 build。"
  }
}
