{
  "kind": "agent_app_prd",
  "project": {
    "name": "工单管理",
    "code": "ticket_management",
    "create_new_directory": true,
    "parent_directory": "",
    "target_directory": "",
    "summary": "管理工单的提交、处理、状态流转和列表筛选。",
    "reason": "工单管理是独立业务域，需要单独目录承载列表和回调逻辑。"
  },
  "models": [
    {
      "name": "工单",
      "description": "记录工单从提交到关闭的完整处理信息。",
      "fields": [
        {
          "name": "工单标题",
          "widget": "name:工单标题;type:input",
          "validate": "required,min=2,max=200",
          "description": "2-200 字，列表支持模糊搜索。"
        },
        {
          "name": "问题描述",
          "widget": "name:问题描述;type:text_area",
          "validate": "required,min=10",
          "description": "至少 10 字。"
        },
        {
          "name": "优先级",
          "widget": "name:优先级;type:select;options:低,中,高;options_colors:67C23A,E6A23C,F56C6C;render_default:中",
          "validate": "required,oneof=低 中 高"
        },
        {
          "name": "工单状态",
          "widget": "name:工单状态;type:select;options:待处理,处理中,已完成,已关闭;options_colors:909399,E6A23C,67C23A,F56C6C;render_default:待处理",
          "validate": "required,oneof=待处理 处理中 已完成 已关闭"
        },
        {
          "name": "问题分类",
          "widget": "name:问题分类;type:select;options:民生,交通,医疗,就业,建议,其他;options_colors:909399,E6A23C,67C23A,F56C6C,FF9800,9C27B0",
          "validate": "required,oneof=民生 交通 医疗 就业 建议 其他"
        },
        {
          "name": "是否紧急",
          "widget": "name:是否紧急;type:switch"
        },
        {
          "name": "完成进度",
          "widget": "name:完成进度;type:slider;min:0;max:100;unit:%",
          "validate": "min=0,max=100"
        },
        {
          "name": "满意度评分",
          "widget": "name:满意度评分;type:slider;min:0;max:10;step:0.1;unit:分",
          "validate": "min=0,max=10"
        },
        {
          "name": "评价",
          "widget": "name:评价;type:rate;max:5;allow_half:true;texts:很差,差,一般,好,很好",
          "validate": "min=0,max=5"
        },
        {
          "name": "联系电话",
          "widget": "name:联系电话;type:input",
          "validate": "required,min=11,max=20"
        },
        {
          "name": "工单来源",
          "widget": "name:工单来源;type:radio;options:电话,邮件,在线,现场,其他;render_default:在线",
          "validate": "required,oneof=电话 邮件 在线 现场 其他"
        },
        {
          "name": "预期处理时长",
          "widget": "name:预期处理时长;type:number;step:1;unit:分钟;render_default:60",
          "validate": "required,min=1,max=10080"
        },
        {
          "name": "处理耗时",
          "widget": "name:处理耗时;type:float;precision:2;unit:分钟;render_default:0.00",
          "hide": "create,update",
          "description": "状态关闭时由后端计算，只在列表展示。"
        },
        {
          "name": "处理人",
          "widget": "name:处理人;type:user;render_default:Me()",
          "validate": "required"
        },
        {
          "name": "抄送人",
          "widget": "name:抄送人;type:users;render_default:Me(),MyLeader()"
        },
        {
          "name": "处理部门",
          "widget": "name:处理部门;type:department;render_default:MyDepartment()",
          "validate": "required"
        },
        {
          "name": "关联部门",
          "widget": "name:关联部门;type:departments;render_default:MyDepartment();max_count:5"
        },
        {
          "name": "备注",
          "widget": "name:备注;type:text_area"
        },
        {
          "name": "详细内容",
          "widget": "name:详细内容;type:richtext;height:400"
        },
        {
          "name": "标签",
          "widget": "name:标签;type:multiselect;options:紧急,重要,普通,低优先级;options_colors:FF5722,FF9800,4CAF50,9E9E9E"
        },
        {
          "name": "主题颜色",
          "widget": "name:主题颜色;type:color;format:hex;render_default:#409EFF"
        },
        {
          "name": "附件",
          "widget": "name:附件;type:files"
        },
        {
          "name": "提单部门",
          "widget": "name:提单部门;type:department",
          "hide": "create,update",
          "description": "新增时由后端写入当前用户部门。"
        },
        {
          "name": "创建用户",
          "widget": "name:创建用户;type:user",
          "hide": "create,update",
          "description": "新增时由后端写入当前用户。"
        },
        {
          "name": "截止时间",
          "widget": "name:截止时间;type:datetime;format:YYYY-MM-DD HH:mm:ss"
        },
        {
          "name": "剩余时间",
          "widget": "name:剩余时间;type:text",
          "hide": "create,update",
          "description": "不落库，列表构建后根据截止时间计算。"
        }
      ]
    }
  ],
  "functions": [
    {
      "title": "工单列表",
      "type": "table",
      "route": "ticket_list.table",
      "method": "GET",
      "model": "工单",
      "description": "管理工单记录，支持搜索、筛选、新增、编辑、删除。",
      "table": {
        "capability": "支持列表查询、模糊搜索、筛选、新增、编辑、删除和回调赋值。",
        "readonly": false,
        "operations": [
          "列表查询",
          "新增",
          "编辑",
          "删除"
        ],
        "request_fields": [
          {
            "field": "工单标题",
            "type": "文本输入",
            "required": false,
            "default": "—",
            "description": "按标题模糊搜索。"
          },
          {
            "field": "优先级",
            "type": "下拉选择",
            "required": false,
            "default": "全部",
            "description": "按低/中/高筛选。"
          },
          {
            "field": "工单状态",
            "type": "下拉选择",
            "required": false,
            "default": "全部",
            "description": "按处理状态筛选。"
          },
          {
            "field": "问题分类",
            "type": "下拉选择",
            "required": false,
            "default": "全部",
            "description": "按业务分类筛选。"
          }
        ],
        "columns": [
          "工单标题",
          "问题描述",
          "优先级",
          "工单状态",
          "问题分类",
          "是否紧急",
          "完成进度",
          "满意度评分",
          "评价",
          "联系电话",
          "工单来源",
          "预期处理时长",
          "处理耗时",
          "处理人",
          "处理部门",
          "截止时间",
          "剩余时间"
        ],
        "sample_rows": [
          {
